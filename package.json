{
  "name": "obsidian-githubpage-monorepo",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint packages tests vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/picomatch": "4.0.3",
    "esbuild": "0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.11"
  }
}
